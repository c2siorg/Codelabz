# Firebase project identity
VITE_APP_FIREBASE_API_KEY=demo-key
VITE_APP_AUTH_DOMAIN=demo-codelabz.firebaseapp.com
VITE_APP_FIREBASE_PROJECT_ID=demo-codelabz
VITE_APP_FIREBASE_STORAGE_BUCKET=demo-codelabz.appspot.com
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_APP_FIREBASE_MEASUREMENTID=G-00000000
VITE_APP_DATABASE_URL=http://localhost:9000?ns=demo-codelabz-default-rtdb

# Docker / Emulator setup
VITE_APP_USE_EMULATOR=true
VITE_APP_EMULATOR_HOST=localhost

# Optional: Firebase Cloud Messaging (not required for emulator mode)
VITE_APP_FIREBASE_FCM_VAPID_KEY=<FIREBASE_VAPID_KEY>

# Optional: Cypress Cloud recording (not required for emulator mode)
CYPRESS_PROJECT_ID=<CYPRESS_PROJECT_ID>
CYPRESS_RECORD_KEY=<CYPRESS_RECORD_KEY>