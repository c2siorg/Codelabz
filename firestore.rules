rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getOrgPermission(org_handle) {
      return get(/databases/$(database)/documents/org_users/$(org_handle + "_" + request.auth.uid)).data.permissions[0];
    }

    function hasOrgPermission(org_handle, minLevel) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/org_users/$(org_handle + "_" + request.auth.uid))
        && getOrgPermission(org_handle) >= minLevel;
    }

    function isOrgMember(org_handle) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/org_users/$(org_handle + "_" + request.auth.uid));
    }

    function isPlatformAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/cl_user/$(request.auth.uid)).data.get('is_platform_admin', false) == true;
    }

    function isValidRole(role) {
      return role is int && role >= 0 && role <= 3;
    }

    function isValidOrgUserDocument(data, memberDoc) {
      return data.keys().hasOnly(['uid', 'org_handle', 'permissions'])
        && data.uid is string
        && data.org_handle is string
        && data.permissions is list
        && data.permissions.size() == 1
        && isValidRole(data.permissions[0])
        && memberDoc == data.org_handle + "_" + data.uid;
    }

    function actorCanManageOrgUser(org_handle, targetRole) {
      return hasOrgPermission(org_handle, 2)
        && targetRole < getOrgPermission(org_handle);
    }

    match /cl_org_general/{org_handle} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if hasOrgPermission(org_handle, 2) || isPlatformAdmin();
      allow delete: if hasOrgPermission(org_handle, 3) || isPlatformAdmin();
    }

    match /org_users/{memberDoc} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidOrgUserDocument(request.resource.data, memberDoc)
        && actorCanManageOrgUser(request.resource.data.org_handle, request.resource.data.permissions[0]);

      allow update: if isAuthenticated()
        && isValidOrgUserDocument(resource.data, memberDoc)
        && isValidOrgUserDocument(request.resource.data, memberDoc)
        && actorCanManageOrgUser(resource.data.org_handle, resource.data.permissions[0])
        && request.resource.data.permissions[0] < getOrgPermission(resource.data.org_handle)
        && resource.data.org_handle == request.resource.data.org_handle
        && resource.data.uid == request.resource.data.uid;

      allow delete: if (isValidOrgUserDocument(resource.data, memberDoc)
        && actorCanManageOrgUser(resource.data.org_handle, resource.data.permissions[0]))
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /cl_user/{userId} {
      allow read: if isAuthenticated();

      // Create and update are kept separate on purpose: on create `resource` is
      // null, so calling diff() against it raises a null error and denies the
      // write -- which would block profile creation at signup.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && !('is_platform_admin' in request.resource.data);

      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !('is_platform_admin' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /org_role_audit/{auditDoc} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin()
            || exists(/databases/$(database)/documents/org_users/$(resource.data.org_handle + "_" + request.auth.uid)));

      allow create, update, delete: if false;
    }

    match /tutorials/{tutorialId} {
      allow read, write: if isAuthenticated();
    }

    match /cl_comments/{commentId} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /org_subscribers/{subDoc} {
      allow read, write: if isAuthenticated();
    }

    match /tag_frequencies/{tagId} {
      allow read, write: if isAuthenticated();
    }

    match /user_followers/{followDoc} {
      allow read, write: if isAuthenticated();
    }

    match /testConnection/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /{collection}/{docId} {
      allow read, write: if false;
    }
  }
}
